// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "git": {
    "disable_git": false
  },
  "terminal": {
    "toolbar": {
      "breadcrumbs": false
    },
    "shell": null,
    "dock": "bottom"
  },
  "title_bar": {
    "show_branch_status_icon": true
  },
  "status_bar": {
    "show_active_file": false,
    "line_endings_button": false
  },
  "close_on_file_delete": true,
  "use_smartcase_search": true,
  "completions": {
    "lsp_fetch_timeout_ms": 120
  },
  "accessible_mode": false,
  "search": {
    "case_sensitive": true
  },
  "instrumentation": {
    "performance_profiler": {
      "enabled": true
    }
  },
  "edit_predictions": {
    "codestral": {
      "api_url": "https://codestral.mistral.ai"
    },
    "allow_data_collection": "no"
  },
  "show_edit_predictions": true,
  "project_panel": {
    "sort_mode": "files_first",
    "hide_hidden": false,
    "hide_root": true,
    "diagnostic_badges": true,
    "bold_folder_labels": true,
    "file_icons": true,
    "hide_gitignore": false,
    "default_width": 240.0,
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "file_icons": false,
    "tree_view": false,
    "dock": "left"
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        }
      },
      "enable_lsp_tasks": true
    }
  },
  "helix_mode": false,
  "show_wrap_guides": true,
  "cursor_blink": true,
  "ui_font_weight": 400.0,
  "auto_update": true,
  "restore_on_startup": "launchpad",
  "session": {
    "restore_unsaved_buffers": true
  },
  "redact_private_values": false,
  "use_system_prompts": true,
  "use_system_path_prompts": true,
  "agent": {
    "sidebar_side": "right",
    "favorite_models": [
      {
        "provider": "zed.dev",
        "model": "gpt-5.6-sol",
        "enable_thinking": true,
        "effort": "medium"
      }
    ],
    "show_turn_stats": true,
    "dock": "right",
    "play_sound_when_agent_done": "when_hidden",
    "default_profile": "ask",
    "default_model": {
        "effort": "medium",
        "enable_thinking": true,
        "provider": "zed.dev",
        "model": "gpt-5.6-sol"
    },
    "model_parameters": []
  },
  "calls": {
    "mute_on_join": true
  },
  "disable_ai": false,
  "confirm_quit": true,
  "icon_theme": {
    "mode": "light",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "telemetry": {
    "anthropic_retention": true,
    "diagnostics": true,
    "metrics": false
  },
  "ui_font_family": "0xProto",
  "buffer_font_family": "0xProto",
  "ui_font_size": 16.0,
  "buffer_font_size": 14.0,
  "buffer_line_height": "standard",
  "theme": {
    "mode": "system",
    "light": "Fleet Dark",
    "dark": "Fleet Dark"
  },
  "soft_wrap": "editor_width",
  "vim_mode": false,
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "code_actions_on_format": {
    "source.organizeImports.biome": true,
    "source.fixAll.biome": true
  }
}
